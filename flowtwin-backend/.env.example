# Copy to .env and fill in. The real .env is git-ignored - never commit secrets.
# Required for AI (Gemini) narration; without it the app falls back to templated narration.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults shown):
# FLOWTWIN_AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
# BACKEND_PORT=8090
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=20000
